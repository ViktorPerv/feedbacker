# =============================================
# Feedbacker — Docker Environment Configuration
# =============================================
# Copy to .env and adjust values for your setup.
# This file is committed; secrets go in .env (gitignored).

# ── App ──
APP_ENV=local
APP_DEBUG=true
APP_PORT=8080
# APP_KEY intentionally NOT set here — it lives in laravel/.env so an empty
# value can never override the real key inside the container.

# ── Database (PostgreSQL) ──
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=feedbacker
DB_USERNAME=feedbacker
DB_PASSWORD=secret

# ── Test Database ──
TEST_DB_DATABASE=feedbacker_test
TEST_DB_USERNAME=feedbacker
TEST_DB_PASSWORD=secret

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
# 'phpredis' uses the compiled PHP extension (installed in the app image).
# Switch to 'predis' only if you also require predis/predis.
REDIS_CLIENT=phpredis

# ── Widget Server (Go) ──
WIDGET_PORT=8081
# The browser-facing origin of the widget service. The embed snippet points
# here, because Go — not Laravel — answers /w/{slug}/{token}.js.
WIDGET_PUBLIC_URL=http://localhost:8081
# Which space the landing page demonstrates the widget with.
WIDGET_DEMO_SPACE=admin-space
DATABASE_URL=postgres://feedbacker:secret@pgsql:5432/feedbacker?sslmode=disable
REDIS_URL=redis:6379

# ── Node / Vite ──
VITE_PORT=5173
UID=1000
GID=1000

# ── Mail ──
# Local development uses Mailpit, which catches everything and shows it at
# http://localhost:8025 — no SMTP account needed. Point these at a real relay
# for anything else.
MAILPIT_IMAGE=axllent/mailpit:latest
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@feedbacker.test
MAIL_FROM_NAME=Feedbacker

# ── Queue ──
# Notifications are queued; `feedbacker-queue` runs the worker.
QUEUE_CONNECTION=redis

# ── Object storage (MinIO / S3) ──
# MinIO ships as an S3-compatible service, so the application talks to it
# through the standard S3 disk and switching to real AWS S3 is a config change.
#
# Note the two URLs:
#   AWS_ENDPOINT — how the *app container* reaches MinIO (service name).
#   AWS_URL      — how the *browser* reaches the same bucket (published port).
# Getting these the wrong way round yields URLs the browser cannot resolve.
FILESYSTEM_DISK=s3
MINIO_IMAGE=bitnamilegacy/minio:latest
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/feedbacker
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=feedbacker
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── GitHub Token (for Composer private repos, optional) ──
# Generate at: https://github.com/settings/tokens
# Scope: read:packages (if using private packages)
GITHUB_TOKEN=
